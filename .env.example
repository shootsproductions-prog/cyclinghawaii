# Strava API credentials
# Get these from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_ATHLETE_ID=

# Strava Club ID (numeric, from https://www.strava.com/clubs/<ID>).
# Defaults to Cycling Hawaiʻi (737679) in code — set only to override.
STRAVA_CLUB_ID=

# Encryption key for rider OAuth tokens stored in Vercel Blob.
# Generate a new one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RIDER_ENCRYPTION_KEY=

# Printful API access token. Get from
# https://www.printful.com/dashboard/store → Settings → API
# Read access is sufficient for product sync. Add write scope if you
# want automated fulfillment via Stripe webhooks.
PRINTFUL_API_TOKEN=

# Password gating /admin/* tools (Laura voice generator, etc.).
# Pick anything you'll remember.
# Also how the site owner unlocks their own Strava rides and the AI
# read on /coach.
ADMIN_PASSWORD=

# ─── /coach ──────────────────────────────────────────────────────
# The coach works with none of these set: ride files and the built-in
# read run entirely in the visitor's browser.
#
# Anthropic API key. Already used by Laura's writing; /coach uses it
# for the optional AI-written read, but only once COACH_AI says who
# may ask for one.
ANTHROPIC_API_KEY=
# Who may ask for the AI read. Every read is billed to the key above.
#   owner      only you (admin password, or your own Strava sign-in)
#   signed-in  you and any signed-in visitor (6 reads an hour each)
# Leave empty to keep it off: everyone gets the rules-based read.
COACH_AI=
# Model for the coach's read. Defaults to claude-opus-5-5. Set to
# claude-haiku-5-5 for a much cheaper read.
COACH_MODEL=
